{
  "manifest_version": 3,
  "name": "Bible Maps",
  "version": "1.0.3",
  "description": "Highlight biblical places and journeys on major Bible sites; open them on an Esri teaching map (Map or Satellite) when online.",
  "permissions": [
    "sidePanel",
    "storage",
    "activeTab",
    "tabs"
  ],
  "host_permissions": [
    "https://*.bible.com/*",
    "https://bible.com/*",
    "https://*.biblegateway.com/*",
    "https://biblegateway.com/*",
    "https://*.biblia.com/*",
    "https://biblia.com/*",
    "https://*.blueletterbible.org/*",
    "https://blueletterbible.org/*",
    "https://*.biblehub.com/*",
    "https://biblehub.com/*",
    "https://*.biblestudytools.com/*",
    "https://biblestudytools.com/*",
    "https://*.google.com/*",
    "https://*.googleapis.com/*",
    "https://*.gstatic.com/*",
    "https://*.arcgisonline.com/*",
    "https://server.arcgisonline.com/*",
    "https://services.arcgisonline.com/*"
  ],
  "background": {
    "service_worker": "background/service-worker.js"
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'; worker-src 'self'; img-src 'self' data: blob: https://*.arcgisonline.com; style-src 'self' 'unsafe-inline'; connect-src 'self' https://*.arcgisonline.com; frame-src 'none'"
  },
  "action": {
    "default_title": "Bible Maps",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "side_panel": {
    "default_path": "sidepanel/sidepanel.html"
  },
  "content_scripts": [
    {
      "matches": [
        "https://*.bible.com/*",
        "https://bible.com/*",
        "https://*.biblegateway.com/*",
        "https://biblegateway.com/*",
        "https://*.biblia.com/*",
        "https://biblia.com/*",
        "https://*.blueletterbible.org/*",
        "https://blueletterbible.org/*",
        "https://*.biblehub.com/*",
        "https://biblehub.com/*",
        "https://*.biblestudytools.com/*",
        "https://biblestudytools.com/*"
      ],
      "js": [
        "content/matcher.js",
        "content/sites.js",
        "content/content.js"
      ],
      "css": [
        "content/content.css"
      ],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "data/*",
        "icons/*"
      ],
      "matches": [
        "https://*.bible.com/*",
        "https://bible.com/*",
        "https://*.biblegateway.com/*",
        "https://biblegateway.com/*",
        "https://*.biblia.com/*",
        "https://biblia.com/*",
        "https://*.blueletterbible.org/*",
        "https://blueletterbible.org/*",
        "https://*.biblehub.com/*",
        "https://biblehub.com/*",
        "https://*.biblestudytools.com/*",
        "https://biblestudytools.com/*"
      ]
    }
  ]
}
